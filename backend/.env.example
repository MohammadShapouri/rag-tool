# ==============================================================================
# Django Core Settings
# ==============================================================================
SECRET_KEY=django-insecure-#w_wy!j&^5t5hs%)si&a#+pjbk$8sn5g0+u+kr%kt4fyw2tsuo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,*

# Optional: Force database engine (defaults to SQLite if DEBUG=True, PostgreSQL if DEBUG=False)
# USE_SQLITE=True

# ==============================================================================
# PostgreSQL Database Settings (Used when DEBUG=False or USE_SQLITE=False)
# ==============================================================================
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=600

# ==============================================================================
# Redis & Celery Task Queue Settings
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# Vector Database (Qdrant) Settings
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_knowledge

# ==============================================================================
# Local AI & Sentence Transformers Settings
# ==============================================================================
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Default fallback Ollama configuration for newly created organizations
DEFAULT_OLLAMA_HOST=http://host.docker.internal
DEFAULT_OLLAMA_PORT=11434
DEFAULT_OLLAMA_MODEL=llama3

# ==============================================================================
# Authentication & JWT Lifetime Settings
# ==============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==============================================================================
# Security & CORS Settings
# ==============================================================================
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
